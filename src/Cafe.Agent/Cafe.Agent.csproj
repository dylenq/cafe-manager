<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Cafe.Agent</AssemblyName>
    <RootNamespace>Cafe.Agent</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cafe.Agent.Core\Cafe.Agent.Core.csproj" />
    <ProjectReference Include="..\Cafe.Shared\Cafe.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <None Update="agentsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
