@page "/customers/{Id:int}"
@attribute [Authorize]
@* CUST-02 (member), CUST-03 (balance per bucket, manual adjustment), CUST-04 (sell package, payment recorded). *@
@using System.Globalization
@using Cafe.Server.Customers
@using CustomerDetailModel = Cafe.Server.Customers.CustomerDetail
@using Cafe.Server.Data
@using Cafe.Server.Payments
@using Cafe.Server.Stations
@inject CustomerService CustomerSvc
@inject PackageService PackageSvc
@inject BalanceService BalanceSvc
@inject PaymentHistoryService HistorySvc
@inject StationTypeService TypeSvc
@inject ILogger<CustomerDetail> Logger

<PageTitle>Customer - Cafe Manager</PageTitle>

@if (!loaded)
{
    <p>Loading...</p>
}
else if (detail is null)
{
    <p class="text-muted">@(errorMessage ?? CustomerService.Gone)</p>
    <a href="customers">Back to customers</a>
}
else
{
    var customer = detail.Customer;
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="h3 mb-0">
            @customer.Name
            @if (customer.IsMember)
            {
                <span class="badge text-bg-info ms-1">Member</span>
            }
            @if (!customer.IsActive)
            {
                <span class="badge text-bg-secondary ms-1">Inactive</span>
            }
        </h1>
        <a href="customers" class="btn btn-outline-secondary">Back to customers</a>
    </div>
    <p class="text-muted">
        @if (!string.IsNullOrEmpty(customer.Phone))
        {
            <span>@PhoneDisplay.Format(customer.Phone)</span>
        }
        @if (!string.IsNullOrEmpty(customer.Notes))
        {
            <span class="ms-2">@customer.Notes</span>
        }
    </p>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible" role="alert">
            @errorMessage
            <button type="button" class="btn-close" aria-label="Close" @onclick="() => errorMessage = null"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(notice))
    {
        <div class="alert alert-success alert-dismissible" role="status">
            @notice
            <button type="button" class="btn-close" aria-label="Close" @onclick="() => notice = null"></button>
        </div>
    }

    <section class="mb-4">
        <h2 class="h5">Balance</h2>
        @if (detail.Balance.Buckets.Count == 0)
        {
            <p class="text-muted">No minutes on balance.</p>
        }
        else
        {
            <table class="table table-sm w-auto">
                <thead><tr><th>Bucket</th><th class="text-end">Minutes</th></tr></thead>
                <tbody>
                    @foreach (var bucket in detail.Balance.Buckets)
                    {
                        <tr>
                            <td>@(bucket.StationTypeId is null ? "Any type" : bucket.StationTypeName ?? "Unknown type")</td>
                            <td class="text-end">@bucket.Minutes</td>
                        </tr>
                    }
                </tbody>
                <tfoot><tr><th>Total</th><th class="text-end">@detail.Balance.TotalMinutes</th></tr></tfoot>
            </table>
        }
    </section>

    <div class="row g-3 mb-4">
        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h5 card-title">Sell package</h2>
                    @if (!customer.IsActive)
                    {
                        <p class="text-muted">Reactivate this customer before selling a package.</p>
                    }
                    else if (packages.Count == 0)
                    {
                        <p class="text-muted">No active packages. Add one on the Packages page.</p>
                    }
                    else
                    {
                        <div class="mb-2">
                            <label class="form-label" for="sell-package">Package</label>
                            <select id="sell-package" class="form-select" @bind="sellPackageId">
                                <option value="0">Choose a package...</option>
                                @foreach (var p in packages)
                                {
                                    <option value="@p.Id">@p.Name - @p.Minutes min - @p.Price.ToString("C", CultureInfo.CurrentCulture)@(p.StationTypeId is null ? "" : " - " + TypeName(p.StationTypeId))</option>
                                }
                            </select>
                        </div>
                        <button type="button" class="btn btn-primary" disabled="@(busy || sellPackageId == 0 || !ShowsCurrentCustomer)" @onclick="BeginSell">Sell package</button>
                    }
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h5 card-title">Manual adjustment</h2>
                    <div class="mb-2">
                        <label class="form-label" for="adj-bucket">Bucket</label>
                        <select id="adj-bucket" class="form-select" @bind="adjustBucket">
                            <option value="0">Any type</option>
                            @foreach (var t in types)
                            {
                                <option value="@t.Id">@t.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="adj-minutes">Minutes (+ or -)</label>
                        <input id="adj-minutes" type="number" class="form-control" @bind="adjustMinutes" />
                        @FieldError("MinutesDelta")
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="adj-note">Note (required)</label>
                        <input id="adj-note" type="text" class="form-control" maxlength="300" @bind="adjustNote" />
                        @FieldError("Note")
                    </div>
                    <button type="button" class="btn btn-outline-primary" disabled="@(busy || !ShowsCurrentCustomer)" @onclick="AdjustAsync">Adjust balance</button>
                </div>
            </div>
        </div>
    </div>

    <section class="mb-4">
        <h2 class="h5">Package purchases</h2>
        @if (detail.Sales.Count == 0)
        {
            <p class="text-muted">No packages bought yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead><tr><th>When</th><th>Package</th><th class="text-end">Minutes</th><th class="text-end">Price</th><th>Payment</th></tr></thead>
                    <tbody>
                        @foreach (var sale in detail.Sales)
                        {
                            <tr>
                                <td>@sale.AtUtc.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)</td>
                                <td>@sale.PackageName</td>
                                <td class="text-end">@sale.Minutes</td>
                                <td class="text-end">@sale.Price.ToString("C", CultureInfo.CurrentCulture)</td>
                                <td>@(sale.Method?.ToString() ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="mb-4 customer-receipts">
        <h2 class="h5">Receipts</h2>
        @if (receipts.Count == 0)
        {
            <p class="text-muted">No receipts yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead><tr><th>When</th><th>For</th><th>Payment</th><th class="text-end">Amount</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var receipt in receipts)
                        {
                            <tr>
                                <td>@receipt.AtUtc.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)</td>
                                <td>@receipt.Label</td>
                                <td>@receipt.Methods</td>
                                <td class="text-end">@receipt.Total.ToString("C", CultureInfo.CurrentCulture)</td>
                                <td><PrintReceiptButton PaymentId="receipt.RootPaymentId" Label="Reprint" CssClass="btn btn-sm btn-outline-secondary" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="mb-4">
        <h2 class="h5">Ledger history</h2>
        @if (detail.Ledger.Count == 0)
        {
            <p class="text-muted">No ledger entries yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead><tr><th>When</th><th>Reason</th><th>Bucket</th><th class="text-end">Minutes</th><th>Note</th><th>Session</th></tr></thead>
                    <tbody>
                        @foreach (var row in detail.Ledger)
                        {
                            <tr>
                                <td>@row.AtUtc.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)</td>
                                <td>@row.ReasonText</td>
                                <td>@(row.StationTypeId is null ? "Any type" : TypeName(row.StationTypeId))</td>
                                <td class="text-end">@(row.MinutesDelta > 0 ? "+" : "")@row.MinutesDelta</td>
                                <td>@row.Note</td>
                                <td>@(row.SessionId is { } sid ? "#" + sid : "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="mb-4">
        <h2 class="h5">Recent sessions</h2>
        @if (detail.Sessions.Count == 0)
        {
            <p class="text-muted">No sessions yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead><tr><th>Started</th><th>Station</th><th>Mode</th><th class="text-end">Charged</th><th>Ended</th></tr></thead>
                    <tbody>
                        @foreach (var s in detail.Sessions)
                        {
                            <tr>
                                <td>@s.StartedAtUtc.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)</td>
                                <td>@s.StationName</td>
                                <td>@s.Mode</td>
                                <td class="text-end">@s.ChargedAmount.ToString("C", CultureInfo.CurrentCulture)</td>
                                <td>@(s.EndedAtUtc is null ? "Running" : s.EndReason?.ToString() ?? "Ended")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (sellPending is { } pending)
    {
        <PaymentDialog Title="Sell package" Items="SellItems(pending)"
                       Due="pending.Price" RequireFullPayment="true" AllowZeroDue="true"
                       OnConfirm="tenders => ConfirmSellAsync(pending, tenders)" OnClosed="SellClosedAsync" />
    }
}

@code {
    private CustomerDetailModel? detail;
    private List<TimePackage> packages = [];
    private List<StationType> types = [];
    private IReadOnlyDictionary<string, string> fieldErrors = new Dictionary<string, string>();
    private bool loaded;
    private bool busy;
    private string? errorMessage;

    /// <summary>True only when the loaded detail belongs to the customer in the URL; sell/adjust are disabled otherwise.</summary>
    private bool ShowsCurrentCustomer => detail is not null && detail.Customer.Id == Id;
    private string? notice;
    private int sellPackageId;
    private TimePackage? sellPending;
    private List<ReceiptSummary> receipts = [];
    private int adjustBucket;
    private int adjustMinutes;
    private string? adjustNote;

    [Parameter] public int Id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (detail?.Customer.Id != Id)
        {
            // Navigated to another customer in the same circuit: drop the previous customer's data and any stale
            // message so nothing from the old page can be shown or acted on.
            detail = null;
            loaded = false;
            errorMessage = null;
            notice = null;
            fieldErrors = new Dictionary<string, string>();
            sellPackageId = 0;
            adjustBucket = 0;
            adjustMinutes = 0;
            adjustNote = null;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            var result = await CustomerSvc.GetDetailAsync(Id);
            detail = result.Success ? result.Value : null;
            if (!result.Success)
            {
                errorMessage = result.Error;
            }

            receipts = detail is null ? [] : (await HistorySvc.ForCustomerAsync(Id, 20)).ToList();
            packages = await PackageSvc.ListAsync(includeInactive: false);
            types = await TypeSvc.ListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load customer {CustomerId}.", Id);
            detail = null;
            errorMessage = "Something went wrong. Refresh the page and try again.";
        }
        finally
        {
            loaded = true;
        }
    }

    private RenderFragment FieldError(string field) => builder =>
    {
        if (fieldErrors.TryGetValue(field, out var message))
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "text-danger small");
            builder.AddContent(2, message);
            builder.CloseElement();
        }
    };

    private string TypeName(int? typeId) =>
        typeId is null ? "Any type" : types.FirstOrDefault(t => t.Id == typeId)?.Name ?? "Unknown type";

    private static IReadOnlyList<OutstandingItem> SellItems(TimePackage package) =>
        [new OutstandingItem(AllocationTargetType.PackageSale, package.Id, package.Name, package.Price, 0m, package.Price)];

    private void BeginSell()
    {
        if (busy || sellPackageId == 0 || !ShowsCurrentCustomer)
        {
            return;
        }

        errorMessage = null;
        notice = null;
        // The price shown in the picker is what the dialog charges; the service refuses if it changed meanwhile.
        sellPending = packages.FirstOrDefault(p => p.Id == sellPackageId);
    }

    private async Task<PaymentDialogResult> ConfirmSellAsync(TimePackage package, IReadOnlyList<TenderLine> tenders)
    {
        var result = await PackageSvc.SellPaidAsync(Id, package.Id, tenders, package.Price);
        return new PaymentDialogResult(result.Success, result.Error, result.Value);
    }

    private async Task SellClosedAsync(bool recorded)
    {
        var sold = sellPending;
        sellPending = null;
        if (recorded && sold is not null)
        {
            notice = $"Sold: {sold.Minutes} min added to the balance.";
            sellPackageId = 0;
        }

        await LoadAsync();
    }

    private async Task AdjustAsync()
    {
        if (busy || !ShowsCurrentCustomer)
        {
            return;
        }

        busy = true;
        errorMessage = null;
        notice = null;
        fieldErrors = new Dictionary<string, string>();
        try
        {
            var result = await BalanceSvc.AdjustAsync(Id, adjustBucket == 0 ? null : adjustBucket, adjustMinutes, adjustNote);
            if (result.Success)
            {
                notice = $"Balance adjusted by {adjustMinutes:+#;-#;0} min.";
                adjustMinutes = 0;
                adjustNote = null;
            }
            else
            {
                errorMessage = result.Error;
                fieldErrors = result.FieldErrors;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not adjust the balance of customer {CustomerId}.", Id);
            errorMessage = "Something went wrong. Try again.";
        }
        finally
        {
            busy = false;
        }

        await LoadAsync();
    }
}
