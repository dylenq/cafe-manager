@page "/"
@using Cafe.Server.Dashboard
@using Cafe.Server.Sessions
@implements IAsyncDisposable
@inject DashboardService Dashboard
@inject SessionNotifier Notifier
@inject Cafe.Server.Agents.AgentRegistry AgentRegistry
@inject Cafe.Server.Devices.TvStateCache TvCache
@inject ILogger<Home> Logger
@inject TimeProvider Time
@inject IJSRuntime Js

<PageTitle>Dashboard</PageTitle>
<SectionContent SectionName="page-title">Dashboard</SectionContent>

<div class="dash-header">
    <div>
        <h1 class="large-title page-title">Dashboard</h1>
        <p class="subhead dash-sub">
            @if (_cards is { Count: > 0 })
            {
                <span>@_cards.Count stations</span><span class="dash-live"><span class="dash-live-dot"></span>Live</span>
            }
            else
            {
                <span>Every station at a glance</span>
            }
        </p>
    </div>
</div>

@if (_stale)
{
    <div class="banner banner-warning" role="status">Live data is temporarily out of date. Retrying...</div>
}

<AlertStrip Alerts="_activeAlerts" Details="_alertDetails" OnAcknowledge="AcknowledgeAsync" />

@foreach (var notice in _notices)
{
    <div class="banner @(notice.Warning ? "banner-warning" : "banner-success") alert-dismissible" role="status" @key="notice.Id">
        @notice.Text
        <button type="button" class="btn-close" aria-label="Dismiss" @onclick="() => _notices.Remove(notice)"></button>
    </div>
}

@if (_cards is null)
{
    <p class="footnote">Loading...</p>
}
else if (_cards.Count == 0)
{
    <div class="banner banner-info">
        No stations yet. Set up <a href="/station-types">station types</a> and then <a href="/stations">stations</a>.
    </div>
}
else
{
    <div class="kpi-row" role="group" aria-label="Filter stations by status">
        @foreach (var f in Filters)
        {
            var count = _cards.Count(c => Matches(c, f.Key));
            <button type="button" class="kpi kpi-@f.Key @(_filter == f.Key ? "is-active" : "")" aria-pressed="@(_filter == f.Key ? "true" : "false")"
                    @onclick="() => _filter = f.Key">
                <span class="kpi-icon"><Icon Name="@f.Icon" Size="16" /></span>
                <span class="kpi-label">@f.Label</span>
                <span class="kpi-value">@count</span>
            </button>
        }
    </div>

    var visible = _cards.Where(c => Matches(c, _filter)).ToList();
    if (visible.Count == 0)
    {
        <div class="dash-empty">No stations match this filter. <button type="button" class="btn btn-link btn-sm" @onclick="ShowAll">Show all</button></div>
    }
    var groups = visible.GroupBy(c => c.TypeName).ToList();
    foreach (var group in groups)
    {
        if (groups.Count > 1)
        {
            <div class="station-group-head">
                <h2 class="station-group-title">@group.Key</h2>
                <span class="station-group-count">@group.Count(c => c.Status == Cafe.Shared.StationStatus.Idle) free of @group.Count()</span>
            </div>
        }
        <div class="station-grid">
            @foreach (var card in group)
            {
                <div class="station-grid-item" @key="card.StationId">
                    <StationCard Model="card" IdleStations="IdleStations" OnNotice="AddNotice" Acknowledged="_tracker.IsAcknowledged(card.StationId)" />
                </div>
            }
        </div>
    }
}

@code {
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(5);

    private readonly CancellationTokenSource _cts = new();
    private PeriodicTimer? _timer;
    private PeriodicTimer? _tickTimer;
    private Task? _loop;
    private Task? _tickLoop;
    private bool _subscribed;
    private List<StationCardModel>? _cards;
    private bool _stale;
    private readonly List<Notice> _notices = [];
    private int _noticeId;

    private sealed record Notice(int Id, string Text, bool Warning = false);

    private sealed record FilterDef(string Key, string Label, string Icon);

    private static readonly FilterDef[] Filters =
    [
        new("all", "All stations", "grid"),
        new("free", "Free", "play"),
        new("busy", "In use", "bolt"),
        new("attention", "Needs attention", "warning"),
        new("offline", "Offline", "offline"),
    ];

    private string _filter = "all";

    private void ShowAll() => _filter = "all";

    private static bool Matches(StationCardModel card, string filter) => filter switch
    {
        "free" => card.Status == Cafe.Shared.StationStatus.Idle,
        "busy" => card.Session is not null,
        "attention" => card.Status == Cafe.Shared.StationStatus.Expiring,
        "offline" => card.Status == Cafe.Shared.StationStatus.Offline,
        _ => true,
    };

    private IReadOnlyList<IdleStation> IdleStations =>
        _cards?.Where(c => c.Session is null).Select(c => new IdleStation(c.StationId, c.Name)).ToList() ?? [];

    private readonly AlertTracker _tracker = new();
    private IReadOnlyList<ActiveAlert> _activeAlerts = [];
    private IReadOnlyDictionary<int, string> _alertDetails = new Dictionary<int, string>();

    private async Task AcknowledgeAsync(int stationId)
    {
        _tracker.Acknowledge(stationId);
        await EvaluateAlertsAsync();
    }

    // Recomputes alert levels at "now", updates the strip and beeps once for stations that just entered an alert.
    private async Task EvaluateAlertsAsync()
    {
        if (_cards is not null)
        {
            var now = Time.GetUtcNow();
            var inputs = new List<AlertInput>();
            var details = new Dictionary<int, string>();
            foreach (var card in _cards)
            {
                if (card.Session is not { } session)
                {
                    continue;
                }

                var level = SessionAlerts.GetLevel(session, now);
                inputs.Add(new AlertInput(card.StationId, card.Name, level));
                if (level == AlertLevel.TimeUp)
                {
                    details[card.StationId] = session.Status == Cafe.Server.Data.SessionStatus.Grace
                        ? $"Grace {SessionClock.FormatCountdown(SessionAlerts.GraceRemainingSeconds(session, now))}"
                        : "Time is up";
                }
                else if (level == AlertLevel.Warning && session.PurchasedMinutes is { } minutes)
                {
                    var active = SessionClock.ActiveSeconds(session.ClosedActiveSeconds, session.OpenSegmentStartUtc, now);
                    details[card.StationId] = $"{SessionClock.FormatCountdown(SessionClock.RemainingSeconds(minutes, active))} left";
                }
            }

            var update = _tracker.Update(inputs);
            _activeAlerts = update.ActiveAlerts;
            _alertDetails = details;

            if (update.NewAlerts.Count > 0 && RendererInfo.IsInteractive)
            {
                var kind = update.NewAlerts.Any(a => a.Level == AlertLevel.TimeUp) ? "timeup" : "warning";
                try
                {
                    await Js.InvokeAsync<bool>("cafeAlerts.beep", kind);
                }
                catch (Exception ex)
                {
                    Logger.LogDebug(ex, "Alert beep unavailable.");
                }
            }
        }

        StateHasChanged();
    }

    private void AddNotice(string text) => _notices.Insert(0, new Notice(++_noticeId, text));

    // A TV state changed: refresh the cards at once. A TV failure: show a warning notice.
    // These events are raised from monitor and queue threads, possibly while the circuit is being disposed: check
    // for disposal first and never let the discarded task fault.
    private void OnTvChanged(int stationId)
    {
        if (_cts.IsCancellationRequested)
        {
            return;
        }

        _ = RefreshNowAsync();
    }

    private void OnTvNotice(string text)
    {
        if (_cts.IsCancellationRequested)
        {
            return;
        }

        _ = ShowTvNoticeAsync(text);
    }

    private async Task ShowTvNoticeAsync(string text)
    {
        try
        {
            await InvokeAsync(() =>
            {
                _notices.Insert(0, new Notice(++_noticeId, text, Warning: true));
                StateHasChanged();
            });
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            // Page left or circuit ended.
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Could not show a TV notice.");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _cards = await Dashboard.GetCardsAsync();
        UpdateTrackerOnly();
    }

    // Prerender and first load: establish alert state without sound.
    private void UpdateTrackerOnly()
    {
        var now = Time.GetUtcNow();
        var update = _tracker.Update((_cards ?? []).Where(c => c.Session is not null)
            .Select(c => new AlertInput(c.StationId, c.Name, SessionAlerts.GetLevel(c.Session!, now))));
        _activeAlerts = update.ActiveAlerts;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && RendererInfo.IsInteractive)
        {
            _timer = new PeriodicTimer(RefreshInterval);
            _loop = RefreshLoopAsync(_timer, _cts.Token);
            _tickTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            _tickLoop = TickLoopAsync(_tickTimer, _cts.Token);
            Notifier.Changed += OnSessionChanged;
            AgentRegistry.Changed += OnAgentChanged;
            TvCache.Changed += OnTvChanged;
            TvCache.NoticeRaised += OnTvNotice;
            _subscribed = true;
        }
    }

    // A session mutation committed somewhere: re-fetch at once instead of waiting for the 5-second poll.
    private void OnSessionChanged(int stationId) => _ = RefreshNowAsync();

    // An agent connected or disconnected: PC online/offline shows at once, not after the next 5-second poll.
    private void OnAgentChanged(string machineId) => _ = RefreshNowAsync();

    private readonly LatestWinsGate _gate = new();

    // Fetches and applies the cards; a result older than one already applied is dropped (responses can overlap
    // and arrive out of order, and a pre-mutation fetch must not overwrite a post-mutation one).
    private async Task FetchAndApplyAsync(CancellationToken token)
    {
        var ticket = _gate.Begin();
        var cards = await Dashboard.GetCardsAsync(token);
        await InvokeAsync(async () =>
        {
            if (!_gate.TryApply(ticket))
            {
                return;
            }

            _cards = cards;
            _stale = false;
            await EvaluateAlertsAsync();
        });
    }

    private async Task RefreshNowAsync()
    {
        try
        {
            await FetchAndApplyAsync(_cts.Token);
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            // Page left or circuit ended.
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Dashboard refresh after a session change failed; the next poll will retry.");
        }
    }

    // Re-render every second so countdowns advance between data refreshes; no data access here.
    private async Task TickLoopAsync(PeriodicTimer timer, CancellationToken token)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                await InvokeAsync(EvaluateAlertsAsync);
            }
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            // Page left or circuit ended.
        }
    }

    private async Task RefreshLoopAsync(PeriodicTimer timer, CancellationToken token)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                try
                {
                    await FetchAndApplyAsync(token);
                }
                catch (Exception ex) when (ex is not (OperationCanceledException or ObjectDisposedException))
                {
                    // A transient failure (e.g. a locked database) must not end live refresh: keep the last
                    // good data on screen, flag it as stale and try again on the next tick.
                    Logger.LogWarning(ex, "Dashboard refresh failed; will retry on the next tick.");
                    await InvokeAsync(() =>
                    {
                        _stale = true;
                        StateHasChanged();
                    });
                }
            }
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            // Page left or circuit ended.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_subscribed)
        {
            Notifier.Changed -= OnSessionChanged;
            AgentRegistry.Changed -= OnAgentChanged;
            TvCache.Changed -= OnTvChanged;
            TvCache.NoticeRaised -= OnTvNotice;
        }

        await _cts.CancelAsync();
        if (_loop is not null)
        {
            try
            {
                await _loop;
            }
            catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
            {
            }
        }

        if (_tickLoop is not null)
        {
            try
            {
                await _tickLoop;
            }
            catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
            {
            }
        }

        _timer?.Dispose();
        _tickTimer?.Dispose();
        _cts.Dispose();
    }
}
