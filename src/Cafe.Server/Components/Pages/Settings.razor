@page "/settings"
@attribute [Authorize]
@using Cafe.Server.Sessions
@using Cafe.Server.Stations
@inject SessionSettingsService SettingsService
@inject ILogger<Settings> Logger

<PageTitle>Settings - Cafe Manager</PageTitle>
<SectionContent SectionName="page-title">Settings</SectionContent>

<div class="page-header">
    <div class="page-heading">
        <h1 class="large-title">Settings</h1>
        <p class="page-sub">Session timing, PC agents, TVs, receipts and backups.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible" role="alert">
        @errorMessage
        <button type="button" class="btn-close" aria-label="Close" @onclick="DismissError"></button>
    </div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success" role="status">@successMessage</div>
}

@if (input is null)
{
    <p class="footnote">Loading...</p>
}
else
{
    <div class="settings-layout">
    <nav class="settings-nav" aria-label="Settings sections">
        <a href="settings#session-expiry"><Icon Name="clock" Size="16" />Session expiry</a>
        <a href="settings#pc-agents"><Icon Name="desktop" Size="16" />PC agents</a>
        <a href="settings#tvs"><Icon Name="tv" Size="16" />Samsung TVs</a>
        <a href="settings#receipts"><Icon Name="receipt" Size="16" />Receipts</a>
        <a href="settings#backups"><Icon Name="server" Size="16" />Backups</a>
    </nav>
    <div class="settings-body">
    <section class="mb-5" id="session-expiry">
        <h2 class="title-2 mb-3">Session expiry</h2>
        <EditForm Model="input" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div class="group mb-2">
                <FormRow Label="Grace period (minutes)" For="setting-grace">
                    <InputNumber id="setting-grace" class="form-control" @bind-Value="input.GracePeriodMinutes" />
                    <ValidationMessage For="() => input.GracePeriodMinutes" class="text-danger" />
                    @FieldError(nameof(SessionSettingsInput.GracePeriodMinutes))
                </FormRow>
                <FormRow Label="Warning minutes" For="setting-warnings">
                    <InputText id="setting-warnings" class="form-control" @bind-Value="input.WarningMinutes" />
                    <ValidationMessage For="() => input.WarningMinutes" class="text-danger" />
                    @FieldError(nameof(SessionSettingsInput.WarningMinutes))
                </FormRow>
            </div>
            <div class="group-footer mb-1">Extra time after a session runs out before the station is locked. 0 to 30.</div>
            <div class="group-footer mb-3">Comma-separated minutes before expiry, for example 10,5,1. The largest value starts the warning window.</div>
            <button type="submit" class="btn btn-primary" disabled="@saving">Save</button>
        </EditForm>
    </section>

    <AgentsPanel />

    <TvSettingsPanel />

    <ReceiptSettingsPanel />

    <BackupPanel />
    </div>
    </div>
}

@code {
    private SessionSettingsInput? input;
    private IReadOnlyDictionary<string, string> fieldErrors = new Dictionary<string, string>();
    private bool saving;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var current = await SettingsService.GetAsync();
            input = new SessionSettingsInput
            {
                GracePeriodMinutes = current.GracePeriodMinutes,
                WarningMinutes = string.Join(",", current.WarningMinutes),
            };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load settings.");
            input = new SessionSettingsInput();
            errorMessage = "Could not load the saved settings. Refresh the page and try again.";
        }
    }

    private RenderFragment FieldError(string field) => builder =>
    {
        if (fieldErrors.TryGetValue(field, out var message))
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "text-danger small");
            builder.AddContent(2, message);
            builder.CloseElement();
        }
    };

    private void DismissError() => errorMessage = null;

    private async Task SaveAsync()
    {
        if (input is null)
        {
            return;
        }

        saving = true;
        successMessage = null;
        try
        {
            var result = await SettingsService.SaveAsync(input);
            if (!result.Success)
            {
                errorMessage = result.Error;
                fieldErrors = result.FieldErrors;
                return;
            }

            errorMessage = null;
            fieldErrors = new Dictionary<string, string>();
            var saved = await SettingsService.GetAsync();
            input.WarningMinutes = string.Join(",", saved.WarningMinutes);
            successMessage = "Settings saved.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not save settings.");
            errorMessage = "Something went wrong. Try again.";
        }
        finally
        {
            saving = false;
        }
    }
}
