@page "/setup"
@attribute [ExcludeFromInteractiveRouting]
@attribute [AllowAnonymous]
@layout PublicLayout
@using System.ComponentModel.DataAnnotations
@using Cafe.Server.Auth
@inject AdminPasswordService Passwords
@inject NavigationManager Navigation
@inject ILogger<Setup> Logger
@using Microsoft.EntityFrameworkCore

<PageTitle>Set up Cafe Manager</PageTitle>

<h1 class="h4 mb-3">Welcome to Cafe Manager</h1>
<p class="text-muted">Choose the admin password staff will use to log in.</p>

<EditForm Model="Model!" FormName="setup" method="post" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" />

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="text-danger mb-3" role="alert">@_error</div>
    }

    <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <InputText id="password" type="password" class="form-control" autocomplete="new-password" @bind-Value="Model!.Password" />
    </div>
    <div class="mb-3">
        <label for="confirm" class="form-label">Confirm password</label>
        <InputText id="confirm" type="password" class="form-control" autocomplete="new-password" @bind-Value="Model!.ConfirmPassword" />
    </div>
    <button type="submit" class="btn btn-primary w-100">Save password</button>
</EditForm>

@code {
    private string? _error;

    [SupplyParameterFromForm]
    private SetupModel? Model { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Model ??= new();
        if (await Passwords.IsConfiguredAsync())
        {
            Navigation.NavigateTo("/login");
        }
    }

    private async Task SubmitAsync()
    {
        // Setup can never be re-run to reset the password.
        if (!await Passwords.IsConfiguredAsync())
        {
            bool saved;
            try
            {
                saved = await Passwords.SetPasswordAsync(Model!.Password);
            }
            catch (Exception ex) when (ex is DbUpdateException or Microsoft.Data.Sqlite.SqliteException)
            {
                Logger.LogError(ex, "Could not save the admin password during setup.");
                saved = false;
            }

            // false with nothing stored means a real failure; false with a stored hash means another visitor won the race.
            if (!saved && !await Passwords.IsConfiguredAsync())
            {
                _error = "Could not save the password. Check that the database file is writable, then try again.";
                return;
            }
        }

        Navigation.NavigateTo("/login");
    }

    public class SetupModel
    {
        // Required also rejects whitespace-only values (AllowEmptyStrings is false).
        [Required(ErrorMessage = "Password is required and cannot be blank.")]
        [StringLength(200, MinimumLength = 8, ErrorMessage = "Password must be at least 8 characters.")]
        public string Password { get; set; } = string.Empty;

        [Compare(nameof(Password), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
