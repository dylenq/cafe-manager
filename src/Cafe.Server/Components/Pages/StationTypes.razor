@page "/station-types"
@using Cafe.Server.Data
@using Cafe.Server.Stations
@inject StationTypeService TypeService
@inject ILogger<StationTypes> Logger

<PageTitle>Station types - Cafe Manager</PageTitle>
<SectionContent SectionName="page-title">Station types</SectionContent>

<div class="page-header">
    <h1 class="large-title">Station types</h1>
    @if (!showForm)
    {
        <div class="page-header-actions">
            <button type="button" class="btn btn-primary" @onclick="StartAdd"><Icon Name="plus" Size="18" />Add station type</button>
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible" role="alert">
        @errorMessage
        <button type="button" class="btn-close" aria-label="Close" @onclick="DismissError"></button>
    </div>
}

@if (showForm)
{
    <EditForm Model="input" OnValidSubmit="SaveAsync" class="mb-4">
        <DataAnnotationsValidator />
        <h2 class="title-2 mb-3">@(editingId is null ? "Add station type" : "Edit station type")</h2>

        <div class="group-caption">Details</div>
        <div class="group">
            <FormRow Label="Name" For="type-name">
                <InputText id="type-name" class="form-control" @bind-Value="input.Name" />
                <ValidationMessage For="() => input.Name" class="text-danger" />
            </FormRow>
            <FormRow Label="Base hourly rate" For="type-rate">
                <InputNumber id="type-rate" class="form-control" @bind-Value="input.HourlyRate" />
                <ValidationMessage For="() => input.HourlyRate" class="text-danger" />
            </FormRow>
            <FormRow Label="Member hourly rate (optional)" For="type-member-rate">
                <InputNumber id="type-member-rate" class="form-control" @bind-Value="input.MemberHourlyRate" />
                <ValidationMessage For="() => input.MemberHourlyRate" class="text-danger" />
            </FormRow>
            <FormRow Label="Sort order" For="type-sort">
                <InputNumber id="type-sort" class="form-control" @bind-Value="input.SortOrder" />
                <ValidationMessage For="() => input.SortOrder" class="text-danger" />
            </FormRow>
        </div>

        <div class="d-flex flex-column flex-sm-row gap-2">
            <button type="submit" class="btn btn-primary" disabled="@saving">Save</button>
            <button type="button" class="btn btn-secondary" @onclick="CancelForm">Cancel</button>
        </div>
    </EditForm>
}

@if (types is null)
{
    <p class="footnote">Loading...</p>
}
else if (types.Count == 0)
{
    <p class="empty-state">No station types yet. Add one to get started.</p>
}
else
{
    <div class="table-card">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th class="num">Hourly rate</th>
                    <th class="num">Member rate</th>
                    <th class="num">Sort order</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var type in types)
                {
                    <tr>
                        <td>@type.Name</td>
                        <td class="num">@type.HourlyRate.ToString("N2")</td>
                        <td class="num">@(type.MemberHourlyRate is { } member ? member.ToString("N2") : "Same as base")</td>
                        <td class="num">@type.SortOrder</td>
                        <td class="text-end">
                            <div class="d-flex flex-wrap gap-2 justify-content-end">
                                @if (confirmingDeleteId == type.Id)
                                {
                                    <button type="button" class="btn btn-sm btn-danger is-prominent" @onclick="() => DeleteAsync(type.Id)">Confirm delete</button>
                                    <button type="button" class="btn btn-sm btn-secondary" @onclick="() => confirmingDeleteId = null">Cancel</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-tinted" @onclick="() => StartEdit(type)">Edit</button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => confirmingDeleteId = type.Id">Delete</button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<StationType>? types;
    private StationTypeInput input = new();
    private int? editingId;
    private int? confirmingDeleteId;
    private bool showForm;
    private bool saving;
    private string? errorMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            types = await TypeService.ListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load station types.");
            types ??= [];
            errorMessage = "Could not load the list. Refresh the page and try again.";
        }
    }

    private void StartAdd()
    {
        input = new StationTypeInput();
        editingId = null;
        errorMessage = null;
        showForm = true;
    }

    private void StartEdit(StationType type)
    {
        input = new StationTypeInput { Name = type.Name, HourlyRate = type.HourlyRate, MemberHourlyRate = type.MemberHourlyRate, SortOrder = type.SortOrder };
        editingId = type.Id;
        confirmingDeleteId = null;
        errorMessage = null;
        showForm = true;
    }

    private void CancelForm()
    {
        showForm = false;
        editingId = null;
        errorMessage = null;
    }

    private void DismissError() => errorMessage = null;

    private async Task SaveAsync()
    {
        saving = true;
        try
        {
            ServiceResult result = editingId is { } id
                ? await TypeService.UpdateAsync(id, input)
                : await TypeService.CreateAsync(input);

            if (!result.Success)
            {
                errorMessage = result.Error;
                if (editingId is not null && result.Kind == FailureKind.NotFound)
                {
                    // Someone else removed it: close the form and refresh so the list is truthful.
                    showForm = false;
                    editingId = null;
                    await LoadAsync();
                }

                return;
            }

            errorMessage = null;
            showForm = false;
            editingId = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not save station type.");
            errorMessage = "Something went wrong. Try again.";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteAsync(int id)
    {
        confirmingDeleteId = null;
        try
        {
            var result = await TypeService.DeleteAsync(id);
            errorMessage = result.Success ? null : result.Error;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not delete station type {TypeId}.", id);
            errorMessage = "Something went wrong. Try again.";
        }

        await LoadAsync();
    }
}
