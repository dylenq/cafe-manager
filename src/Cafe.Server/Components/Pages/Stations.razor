@page "/stations"
@using Cafe.Server.Data
@using Cafe.Server.Stations
@using Cafe.Shared
@inject StationService StationSvc
@inject StationTypeService TypeSvc
@inject ILogger<Stations> Logger

<PageTitle>Stations - Cafe Manager</PageTitle>
<SectionContent SectionName="page-title">Stations</SectionContent>

<div class="page-header">
    <div class="page-heading">
        <h1 class="large-title">Stations</h1>
        <p class="page-sub">Every PC and console in the cafe, and how it connects.</p>
    </div>
    @if (!showForm)
    {
        <div class="page-header-actions">
            <button type="button" class="btn btn-primary" @onclick="StartAdd"><Icon Name="plus" Size="18" />Add station</button>
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible" role="alert">
        @errorMessage
        <button type="button" class="btn-close" aria-label="Close" @onclick="DismissError"></button>
    </div>
}

@if (types is { Count: 0 })
{
    <div class="alert alert-warning" role="alert">
        There are no station types yet. Create one on the <a href="/station-types">station types</a> page first.
    </div>
}

@if (showForm)
{
    <EditForm Model="input" OnValidSubmit="SaveAsync" class="mb-4">
        <DataAnnotationsValidator />
        <h2 class="title-2 mb-3">@(editingId is null ? "Add station" : "Edit station")</h2>

        <div class="group-caption">Details</div>
        <div class="group">
            <FormRow Label="Name" For="station-name">
                <InputText id="station-name" class="form-control" @bind-Value="input.Name" />
                <ValidationMessage For="() => input.Name" class="text-danger" />
            </FormRow>
            <FormRow Label="Station type" For="station-type">
                <InputSelect id="station-type" class="form-select" @bind-Value="input.StationTypeId">
                    <option value="0">Choose a type...</option>
                    @foreach (var type in types ?? [])
                    {
                        <option value="@type.Id">@type.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => input.StationTypeId" class="text-danger" />
            </FormRow>
            <FormRow Label="Kind" For="station-kind">
                <InputSelect id="station-kind" class="form-select" @bind-Value="input.Kind" @bind-Value:after="OnKindChanged">
                    <option value="@StationKind.PC">PC</option>
                    <option value="@StationKind.Console">Console</option>
                </InputSelect>
            </FormRow>
            <FormRow Label="Sort order" For="station-sort">
                <InputNumber id="station-sort" class="form-control" @bind-Value="input.SortOrder" />
                <ValidationMessage For="() => input.SortOrder" class="text-danger" />
            </FormRow>
            <FormRow Label="Enabled" For="station-enabled" Switch="true">
                <div class="form-check form-switch">
                    <InputCheckbox id="station-enabled" class="form-check-input" role="switch" @bind-Value="input.IsEnabled" />
                </div>
            </FormRow>
        </div>

        <div class="group-caption">Connection</div>
        <div class="group">
            @if (input.Kind == StationKind.PC)
            {
                <FormRow Label="Agent machine ID" For="station-machine">
                    <InputText id="station-machine" class="form-control" @bind-Value="input.AgentMachineId" />
                    <ValidationMessage For="() => input.AgentMachineId" class="text-danger" />
                </FormRow>
            }
            else
            {
                <FormRow Label="TV IP address" For="station-ip">
                    <InputText id="station-ip" class="form-control" @bind-Value="input.TvIpAddress" placeholder="192.168.1.50" />
                    <ValidationMessage For="() => input.TvIpAddress" class="text-danger" />
                </FormRow>
                <FormRow Label="TV MAC address" For="station-mac">
                    <InputText id="station-mac" class="form-control" @bind-Value="input.TvMacAddress" placeholder="AA:BB:CC:DD:EE:FF" />
                    <ValidationMessage For="() => input.TvMacAddress" class="text-danger" />
                </FormRow>
            }
        </div>

        <div class="d-flex flex-column flex-sm-row gap-2">
            <button type="submit" class="btn btn-primary" disabled="@(saving || types is not { Count: > 0 })">Save</button>
            <button type="button" class="btn btn-secondary" @onclick="CancelForm">Cancel</button>
        </div>
    </EditForm>
}

@if (stations is null)
{
    <p class="footnote">Loading...</p>
}
else if (stations.Count == 0)
{
    <p class="empty-state">No stations yet. Add one to get started.</p>
}
else
{
    <div class="table-card">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Kind</th>
                    <th>Endpoint</th>
                    <th>Enabled</th>
                    <th class="num">Sort order</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var station in stations)
                {
                    <tr>
                        <td>@station.Name</td>
                        <td>@station.StationType.Name</td>
                        <td>@station.Kind</td>
                        <td>@(station.Kind == StationKind.PC ? station.AgentMachineId : station.TvIpAddress)</td>
                        <td>@(station.IsEnabled ? "Yes" : "No")</td>
                        <td class="num">@station.SortOrder</td>
                        <td class="text-end">
                            @if (station.Kind == StationKind.Console && !string.IsNullOrWhiteSpace(station.TvIpAddress))
                            {
                                <TvPairControl StationId="station.Id" StationName="@station.Name" Paired="@(!string.IsNullOrWhiteSpace(station.TvToken))" OnPaired="LoadAsync" />
                            }
                            <div class="d-flex flex-wrap gap-2 justify-content-end">
                                @if (confirmingDeleteId == station.Id)
                                {
                                    <button type="button" class="btn btn-sm btn-danger is-prominent" @onclick="() => DeleteAsync(station.Id)">Confirm delete</button>
                                    <button type="button" class="btn btn-sm btn-secondary" @onclick="() => confirmingDeleteId = null">Cancel</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-tinted" @onclick="() => StartEdit(station)">Edit</button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => confirmingDeleteId = station.Id">Delete</button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Station>? stations;
    private List<StationType>? types;
    private StationInput input = new();
    private int? editingId;
    private int? confirmingDeleteId;
    private bool showForm;
    private bool saving;
    private string? errorMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            types = await TypeSvc.ListAsync();
            stations = await StationSvc.ListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load stations.");
            types ??= [];
            stations ??= [];
            errorMessage = "Could not load the list. Refresh the page and try again.";
        }
    }

    private void StartAdd()
    {
        input = new StationInput { StationTypeId = types?.FirstOrDefault()?.Id ?? 0 };
        editingId = null;
        errorMessage = null;
        showForm = true;
    }

    private void StartEdit(Station station)
    {
        input = new StationInput
        {
            Name = station.Name,
            StationTypeId = station.StationTypeId,
            Kind = station.Kind,
            AgentMachineId = station.AgentMachineId,
            TvIpAddress = station.TvIpAddress,
            TvMacAddress = station.TvMacAddress,
            SortOrder = station.SortOrder,
            IsEnabled = station.IsEnabled
        };
        editingId = station.Id;
        confirmingDeleteId = null;
        errorMessage = null;
        showForm = true;
    }

    // Fields of the kind that is no longer selected are hidden, so clear them: stale invalid values would otherwise
    // fail validation with no visible message.
    private void OnKindChanged()
    {
        if (input.Kind == StationKind.PC)
        {
            input.TvIpAddress = null;
            input.TvMacAddress = null;
        }
        else
        {
            input.AgentMachineId = null;
        }
    }

    private void CancelForm()
    {
        showForm = false;
        editingId = null;
        errorMessage = null;
    }

    private void DismissError() => errorMessage = null;

    private async Task SaveAsync()
    {
        saving = true;
        try
        {
            ServiceResult result = editingId is { } id
                ? await StationSvc.UpdateAsync(id, input)
                : await StationSvc.CreateAsync(input);

            if (!result.Success)
            {
                errorMessage = result.Error;
                if (editingId is not null && result.Kind == FailureKind.NotFound)
                {
                    showForm = false;
                    editingId = null;
                    await LoadAsync();
                }

                return;
            }

            errorMessage = null;
            showForm = false;
            editingId = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not save station.");
            errorMessage = "Something went wrong. Try again.";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteAsync(int id)
    {
        confirmingDeleteId = null;
        try
        {
            var result = await StationSvc.DeleteAsync(id);
            errorMessage = result.Success ? null : result.Error;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not delete station {StationId}.", id);
            errorMessage = "Something went wrong. Try again.";
        }

        await LoadAsync();
    }
}
