@using Cafe.Server.Dashboard

@if (Alerts.Count > 0)
{
    <div class="alert-strip" role="alert" aria-live="polite">
        @foreach (var alert in Alerts)
        {
            <div class="alert-strip-row @(alert.Acknowledged ? "alert-strip-ack" : "alert-pulse-box")" @key="alert.StationId">
                <div class="alert-strip-text">
                    <Icon Name="clock" Size="18" Class="alert-strip-icon" />
                    <strong>@alert.StationName</strong>
                    <span class="alert-strip-level">@(alert.Level == AlertLevel.TimeUp ? "TIME UP" : "Expiring")</span>
                    @if (Details.TryGetValue(alert.StationId, out var detail))
                    {
                        <span class="alert-strip-detail">@detail</span>
                    }
                </div>
                @if (alert.Acknowledged)
                {
                    <span class="alert-strip-state">Acknowledged</span>
                }
                else
                {
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="() => OnAcknowledge.InvokeAsync(alert.StationId)">Acknowledge</button>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ActiveAlert> Alerts { get; set; } = [];

    [Parameter] public IReadOnlyDictionary<int, string> Details { get; set; } = new Dictionary<int, string>();

    [Parameter] public EventCallback<int> OnAcknowledge { get; set; }
}
