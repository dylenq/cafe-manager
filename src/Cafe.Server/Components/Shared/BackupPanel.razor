@using System.Globalization
@using Cafe.Server.Backups
@using Cafe.Server.Pricing
@inject BackupService Backups
@inject PricingConfigService Pricing

<section class="mb-5" id="backups">
    <h2 class="title-2 mb-3">Backups</h2>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }

    @if (!string.IsNullOrEmpty(_notice))
    {
        <div class="alert alert-success" role="status">@_notice</div>
    }

    <div class="group mb-3">
        <div class="group-row">
            <span class="row-label">Last backup</span>
            <span class="row-value">@LastBackupText</span>
        </div>
        <div class="group-row">
            <span class="row-label">Backup folder</span>
            <span class="row-value font-monospace text-break">@Backups.Directory</span>
        </div>
        <div class="group-row">
            <span class="row-label">Retention</span>
            <span class="row-value">Keeps the newest @Backups.Keep backups. A copy is made every night at @Backups.Hour:00.</span>
        </div>
    </div>

    <button type="button" class="btn btn-secondary" @onclick="BackUpNowAsync" disabled="@_running">
        @(_running ? "Backing up..." : "Back up now")
    </button>
</section>

@code {
    private bool _running;
    private string? _error;
    private string? _notice;
    private DateTimeOffset? _last;

    protected override void OnInitialized() => _last = Backups.LastBackupUtc;

    private string LastBackupText => _last is { } at
        ? TimeZoneInfo.ConvertTime(at, Pricing.TimeZone).ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture)
        : "Never";

    private async Task BackUpNowAsync()
    {
        _running = true;
        _error = null;
        _notice = null;
        try
        {
            var result = await Backups.BackupNowAsync();
            if (result.Success)
            {
                _notice = $"Backup saved as {result.FileName}.";
            }
            else
            {
                _error = result.Error ?? "Backup failed. See the server log.";
            }

            _last = Backups.LastBackupUtc;
        }
        finally
        {
            _running = false;
        }
    }
}
