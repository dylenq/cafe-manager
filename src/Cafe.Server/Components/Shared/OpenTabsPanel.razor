@using Cafe.Server.Data
@using Cafe.Server.Orders
@using Cafe.Server.Payments
@inject OpenTabsService TabsService
@inject SettlementService Settlement
@inject OrderService Orders
@inject ILogger<OpenTabsPanel> Logger

<h2 class="group-caption tabs-caption">Open tabs</h2>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="banner banner-danger alert alert-danger alert-dismissible" role="alert">
        @errorMessage
        <button type="button" class="btn-close" aria-label="Close" @onclick="() => errorMessage = null"></button>
    </div>
}

@if (groups is null)
{
    <p class="footnote">Loading...</p>
}
else if (groups.Count == 0)
{
    <div class="group"><div class="group-row"><span class="footnote">No open tabs</span></div></div>
}
else
{
    @foreach (var group in groups)
    {
        <div class="group tab-group">
            <div class="group-row tab-head">
                <div class="tab-head-info">
                    <div class="fw-semibold">@group.Header</div>
                    @if (IsRunning(group))
                    {
                        <div class="footnote">Session still running</div>
                    }
                </div>
                <div class="num fw-semibold">@group.TotalOutstanding.ToString("C")</div>
            </div>
            @foreach (var item in group.Items)
            {
                <div class="group-row tab-item">
                    <span class="tab-item-label">@(item.Type == AllocationTargetType.Session ? $"Session charge ({item.Label})" : item.Label)</span>
                    <span class="tab-item-end">
                        <span class="num">@item.Outstanding.ToString("C")@(item.Paid > 0m ? $" of {item.Total:C}" : "")</span>
                        @if (item.Type == AllocationTargetType.Order)
                        {
                            @if (confirmingVoidId == item.Id)
                            {
                                <span class="footnote">Void this order?</span>
                                <button type="button" class="btn btn-sm btn-danger" disabled="@busy" @onclick="() => VoidAsync(item.Id)">Yes</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => confirmingVoidId = null">No</button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => confirmingVoidId = item.Id">Void</button>
                            }
                        }
                    </span>
                </div>
            }
            <div class="group-row tab-foot">
                <button type="button" class="btn btn-outline-primary btn-tinted w-100" disabled="@busy" @onclick="() => settling = group">Settle</button>
            </div>
        </div>
    }
}

@if (settling is { } current)
{
    <PaymentDialog Title="@($"Settle {current.Header}")" Items="current.Items" Due="current.TotalOutstanding"
                   OnConfirm="tenders => SettleAsync(current, tenders)" OnClosed="SettleClosedAsync" />
}

@code {
    private const string RunningSuffix = " - open session";

    private IReadOnlyList<OpenTabGroup>? groups;
    private OpenTabGroup? settling;
    private int? confirmingVoidId;
    private bool busy;
    private string? errorMessage;

    [Parameter] public EventCallback OnChanged { get; set; }

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private static bool IsRunning(OpenTabGroup group) => group.SessionId is not null && group.Header.EndsWith(RunningSuffix, StringComparison.Ordinal);

    public async Task RefreshAsync()
    {
        try
        {
            groups = await TabsService.GetOpenTabsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load open tabs.");
            groups ??= [];
            errorMessage = "Could not load the open tabs. Refresh the page and try again.";
        }

        StateHasChanged();
    }

    private async Task<PaymentDialogResult> SettleAsync(OpenTabGroup group, IReadOnlyList<TenderLine> tenders)
    {
        var targets = group.Items.Select(i => new SettleTarget(i.Type, i.Id)).ToList();
        var result = await Settlement.SettleAsync(new SettleRequest(targets, tenders, group.TotalOutstanding));
        return new PaymentDialogResult(result.Success, result.Error, result.Value);
    }

    private async Task SettleClosedAsync(bool recorded)
    {
        settling = null;
        await RefreshAsync();
        if (recorded)
        {
            await OnChanged.InvokeAsync();
        }
    }

    private async Task VoidAsync(int orderId)
    {
        if (busy)
        {
            return;
        }

        busy = true;
        confirmingVoidId = null;
        try
        {
            var result = await Orders.VoidAsync(orderId);
            errorMessage = result.Success ? null : result.Error;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not void order {OrderId}.", orderId);
            errorMessage = "Something went wrong. Try again.";
        }
        finally
        {
            busy = false;
        }

        await RefreshAsync();
        await OnChanged.InvokeAsync();
    }
}
