@using Cafe.Server.Receipts
@inject ReceiptSettingsService SettingsService
@inject ReceiptPrintService PrintService
@inject ILogger<ReceiptSettingsPanel> Logger

<section class="mb-5 receipt-settings">
    <h2 class="title-2 mb-3">Receipts</h2>
    @if (input is null)
    {
        <p class="footnote">Loading...</p>
    }
    else
    {
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success" role="status">@successMessage</div>
        }
        <EditForm Model="input" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <div class="group-caption">Printer</div>
            <div class="group mb-2">
                <FormRow Label="Print mode" For="receipt-mode">
                    <InputSelect id="receipt-mode" class="form-select" @bind-Value="input.Mode">
                        <option value="@ReceiptMode.None">None</option>
                        <option value="@ReceiptMode.Network">Network printer</option>
                        <option value="@ReceiptMode.WindowsPrinter">Windows printer</option>
                        <option value="@ReceiptMode.Browser">Browser</option>
                    </InputSelect>
                    @FieldError(nameof(ReceiptSettingsInput.Mode))
                </FormRow>
                <FormRow Label="Printer host or IP" For="receipt-host">
                    <InputText id="receipt-host" class="form-control" @bind-Value="input.Host" />
                    <ValidationMessage For="() => input.Host" class="text-danger" />
                    @FieldError(nameof(ReceiptSettingsInput.Host))
                </FormRow>
                <FormRow Label="Port" For="receipt-port">
                    <InputNumber id="receipt-port" class="form-control" @bind-Value="input.Port" />
                    <ValidationMessage For="() => input.Port" class="text-danger" />
                    @FieldError(nameof(ReceiptSettingsInput.Port))
                </FormRow>
                <FormRow Label="Windows printer name" For="receipt-windows">
                    <InputText id="receipt-windows" class="form-control" @bind-Value="input.WindowsPrinter" />
                    <ValidationMessage For="() => input.WindowsPrinter" class="text-danger" />
                    @FieldError(nameof(ReceiptSettingsInput.WindowsPrinter))
                </FormRow>
                <FormRow Label="Paper width" For="receipt-columns">
                    <InputSelect id="receipt-columns" class="form-select" @bind-Value="input.Columns">
                        <option value="42">42 columns (80mm)</option>
                        <option value="32">32 columns (58mm)</option>
                    </InputSelect>
                    @FieldError(nameof(ReceiptSettingsInput.Columns))
                </FormRow>
            </div>
            <div class="group-footer mb-4">Network mode falls back to the named Windows printer if the network printer cannot be reached.</div>

            <div class="group-caption">Receipt header and footer</div>
            <div class="group">
                <FormRow Label="Cafe name" For="receipt-name">
                    <InputText id="receipt-name" class="form-control" @bind-Value="input.CafeName" />
                    <ValidationMessage For="() => input.CafeName" class="text-danger" />
                    @FieldError(nameof(ReceiptSettingsInput.CafeName))
                </FormRow>
                <FormRow Label="Phone" For="receipt-phone">
                    <InputText id="receipt-phone" class="form-control" @bind-Value="input.Phone" />
                    <ValidationMessage For="() => input.Phone" class="text-danger" />
                    @FieldError(nameof(ReceiptSettingsInput.Phone))
                </FormRow>
                <FormRow Label="Address" For="receipt-address">
                    <InputText id="receipt-address" class="form-control" @bind-Value="input.Address" />
                    <ValidationMessage For="() => input.Address" class="text-danger" />
                    @FieldError(nameof(ReceiptSettingsInput.Address))
                </FormRow>
                <FormRow Label="Footer" For="receipt-footer">
                    <InputText id="receipt-footer" class="form-control" @bind-Value="input.Footer" />
                    <ValidationMessage For="() => input.Footer" class="text-danger" />
                    @FieldError(nameof(ReceiptSettingsInput.Footer))
                </FormRow>
            </div>

            <div class="d-flex flex-column flex-sm-row gap-2">
                <button type="submit" class="btn btn-primary" disabled="@saving">Save</button>
                <button type="button" class="btn btn-secondary" disabled="@testing" @onclick="TestPrintAsync">Print test receipt</button>
            </div>
        </EditForm>
        @if (testError is not null)
        {
            <div class="alert alert-danger mt-3 mb-0" role="alert">Test print failed: @testError</div>
        }
        else if (testInfo is not null)
        {
            <div class="alert alert-info mt-3 mb-0" role="status">@testInfo</div>
        }
    }
</section>

@code {
    private ReceiptSettingsInput? input;
    private IReadOnlyDictionary<string, string> fieldErrors = new Dictionary<string, string>();
    private bool saving;
    private bool testing;
    private string? errorMessage;
    private string? successMessage;
    private string? testInfo;
    private string? testError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var current = await SettingsService.GetAsync();
            input = new ReceiptSettingsInput
            {
                Mode = current.Mode,
                Host = current.Host,
                Port = current.Port,
                WindowsPrinter = current.WindowsPrinter,
                Columns = current.Columns,
                CafeName = current.CafeName,
                Address = current.Address,
                Phone = current.Phone,
                Footer = current.Footer,
            };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load receipt settings.");
            input = new ReceiptSettingsInput();
            errorMessage = "Could not load the saved receipt settings. Refresh the page and try again.";
        }
    }

    private RenderFragment FieldError(string field) => builder =>
    {
        if (fieldErrors.TryGetValue(field, out var message))
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "text-danger small");
            builder.AddContent(2, message);
            builder.CloseElement();
        }
    };

    private async Task SaveAsync()
    {
        if (input is null || saving)
        {
            return;
        }

        saving = true;
        successMessage = null;
        try
        {
            var result = await SettingsService.SaveAsync(input);
            if (!result.Success)
            {
                errorMessage = result.Error;
                fieldErrors = result.FieldErrors;
                return;
            }

            errorMessage = null;
            fieldErrors = new Dictionary<string, string>();
            successMessage = "Receipt settings saved.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not save receipt settings.");
            errorMessage = "Something went wrong. Try again.";
        }
        finally
        {
            saving = false;
        }
    }

    private async Task TestPrintAsync()
    {
        if (testing)
        {
            return;
        }

        testing = true;
        testInfo = null;
        testError = null;
        try
        {
            var outcome = await PrintService.PrintTestAsync();
            switch (outcome.Kind)
            {
                case PrintOutcomeKind.Printed:
                    testInfo = "Test receipt sent to the printer.";
                    break;
                case PrintOutcomeKind.Failed:
                    testError = outcome.Error ?? "The printer did not respond.";
                    break;
                default:
                    testInfo = outcome.Message ?? "Nothing was printed.";
                    break;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Test receipt failed.");
            testError = "Something went wrong. Nothing was changed.";
        }
        finally
        {
            testing = false;
        }
    }
}
