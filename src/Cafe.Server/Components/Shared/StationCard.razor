@using Cafe.Server.Customers
@using Cafe.Server.Dashboard
@using Cafe.Server.Data
@using Cafe.Server.Payments
@using Cafe.Server.Sessions
@using Cafe.Server.Stations
@using Cafe.Shared
@inject SessionService Sessions
@inject CheckoutService Checkout
@inject BalanceService Balances
@inject TimeProvider Time
@inject ILogger<StationCard> Logger

<div class="card station-card station-@Model.Status.ToString().ToLowerInvariant() @LevelClass">
    <div class="tile-head">
        <div class="tile-id">
            <h2 class="tile-name">@Model.Name</h2>
            <div class="tile-meta">
                <span class="tile-type">@Model.TypeName</span>
                <span class="capsule capsule-gray kind-capsule"><Icon Name="@(Model.Kind == StationKind.PC ? "desktop" : "tv")" Size="12" />@(Model.Kind == StationKind.PC ? "PC" : "Console")</span>
                @if (Model.AgentOffline && Model.Session is not null)
                {
                    <span class="capsule capsule-orange agent-offline-badge" title="The PC agent is not connected"><span class="dot"></span>Agent offline</span>
                }
            </div>
        </div>
        <div class="tile-status">
            <StatusBadge Status="Model.Status" />
            @if (Model.Kind == StationKind.PC && Model.HasAgent)
            {
                <PcCommandMenu StationId="Model.StationId" StationName="@Model.Name" AgentOffline="Model.AgentOffline"
                               HasActiveSession="Model.Session is not null" />
            }
        </div>
    </div>

    @if (Model.Kind == StationKind.Console && Model.HasTv)
    {
        <TvControls StationId="Model.StationId" StationName="@Model.Name" State="Model.TvState"
                    HasActiveSession="Model.Session is not null" />
    }

    @if (Model.Session is { } session)
    {
        var now = Time.GetUtcNow();
        var level = SessionAlerts.GetLevel(session, now);
        var isPrepaid = session.Mode.IsTimed();
        <div class="tile-clock">
            @if (level == AlertLevel.TimeUp)
            {
                <div class="countdown is-timeup time-up">TIME UP</div>
                @if (session.Status == SessionStatus.Grace)
                {
                    <div class="tile-grace session-grace">Grace @SessionClock.FormatCountdown(SessionAlerts.GraceRemainingSeconds(session, now))</div>
                }
            }
            else
            {
                <div class="countdown session-countdown@(level == AlertLevel.Warning ? " is-expiring" : "")">@Countdown(session, now)</div>
            }
            @if (Progress(session, now) is { } pct)
            {
                <div class="tile-progress" role="progressbar" aria-label="Time used" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@pct">
                    <span style="width:@(pct)%"></span>
                </div>
            }
            else if (session.Mode == SessionMode.OpenEnded)
            {
                <div class="tile-clock-note">Elapsed</div>
            }
        </div>
        <div class="tile-foot">
            <span>@(session.Mode == SessionMode.Balance ? "Balance" : isPrepaid ? "Prepaid" : "Open-ended")</span>
            @if (session.CustomerName is { Length: > 0 } customerName)
            {
                <span class="session-customer"><strong>@customerName</strong>@if (session.IsMemberPricing){<span class="capsule capsule-blue">Member</span>}</span>
            }
            <span>@(isPrepaid ? "Charge" : "Charge est.") @session.ChargeAmount.ToString("C")</span>
            @if (Acknowledged)
            {
                <span>Alert acknowledged</span>
            }
        </div>

        @if (_confirmQuote is { } quote && _confirmSessionId == session.SessionId)
        {
            <div class="tile-flow stop-confirm">
                <div class="flow-title">Final charge: @quote.ToString("C")</div>
                @if (_confirmRefund > 0)
                {
                    <div class="flow-note stop-refund">Refund @_confirmRefund min to balance</div>
                }
                @if (_confirmOrders.Count > 0)
                {
                    <div class="flow-lines stop-orders">
                        <div class="flow-line"><span>Session charge</span><span>@quote.ToString("C")</span></div>
                        @foreach (var order in _confirmOrders)
                        {
                            <div class="flow-line"><span>@order.Label</span><span>@order.Outstanding.ToString("C")</span></div>
                        }
                    </div>
                }
                @if (_confirmTotalDue > 0m)
                {
                    <div class="flow-title stop-total-due">Total due: @_confirmTotalDue.ToString("C")</div>
                    <div class="tile-actions">
                        <button type="button" class="btn btn-sm btn-primary" disabled="@_busy"
                                @onclick="BeginSettle">Stop &amp; settle</button>
                        <button type="button" class="btn btn-sm btn-outline-danger" disabled="@_busy"
                                @onclick="() => ConfirmStopAsync(session.SessionId)">Stop, pay later</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy"
                                @onclick="ClearConfirm">Cancel</button>
                    </div>
                }
                else
                {
                    <div class="tile-actions">
                        <button type="button" class="btn btn-sm btn-danger is-prominent" disabled="@_busy"
                                @onclick="() => ConfirmStopAsync(session.SessionId)">Confirm stop</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy"
                                @onclick="ClearConfirm">Cancel</button>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="tile-actions">
                @if (session.Status == SessionStatus.Active)
                {
                    <button type="button" class="btn btn-sm btn-outline-warning" disabled="@_busy"
                            @onclick="() => PauseAsync(session.SessionId)">Pause</button>
                }
                @if (session.Status == SessionStatus.Paused)
                {
                    <button type="button" class="btn btn-sm btn-outline-success" disabled="@_busy"
                            @onclick="() => ResumeAsync(session.SessionId)">Resume</button>
                }
                <button type="button" class="btn btn-sm btn-outline-danger@(level == AlertLevel.TimeUp ? " is-prominent" : "")" disabled="@_busy"
                        @onclick="() => BeginStopAsync(session.SessionId)">Stop</button>
            </div>

            @if (session.Mode == SessionMode.Balance)
            {
                <div class="tile-flow extend-balance">
                    <div class="flow-label">Extend from balance</div>
                    <div class="flow-controls quick-picks">
                        @foreach (var m in ExtendPicks)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary" disabled="@_busy"
                                    @onclick="() => ExtendFromBalanceAsync(session.SessionId, m)">+@m</button>
                        }
                    </div>
                    <div class="flow-controls">
                        <input type="number" class="form-control form-control-sm custom-minutes" min="1" max="1440"
                               placeholder="min" aria-label="Custom extend from balance minutes" @bind="_customExtend" />
                        <button type="button" class="btn btn-sm btn-outline-primary" disabled="@(_busy || _customExtend is null)"
                                @onclick="() => ExtendFromBalanceAsync(session.SessionId, _customExtend ?? 0)">Extend from balance</button>
                    </div>
                    @if (_payFallbackMinutes is { } fallbackMinutes && _payFallbackSessionId == session.SessionId)
                    {
                        <div class="flow-sub pay-fallback">
                            <div>@_payFallbackReason</div>
                            <div class="flow-controls">
                                <button type="button" class="btn btn-sm btn-warning" disabled="@_busy"
                                        @onclick="() => PayForExtensionAsync(session.SessionId, fallbackMinutes)">Pay for the extension instead (@fallbackMinutes min)</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy"
                                        @onclick="ClearPayFallback">Cancel</button>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (isPrepaid)
            {
                <div class="tile-flow">
                    <div class="flow-label">Extend</div>
                    <div class="flow-controls quick-picks">
                        @foreach (var m in ExtendPicks)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary" disabled="@_busy"
                                    @onclick="() => ExtendAsync(session.SessionId, m)">+@m</button>
                        }
                    </div>
                    <div class="flow-controls">
                        <input type="number" class="form-control form-control-sm custom-minutes" min="1" max="1440"
                               placeholder="min" aria-label="Custom extend minutes" @bind="_customExtend" />
                        <button type="button" class="btn btn-sm btn-outline-primary" disabled="@(_busy || _customExtend is null)"
                                @onclick="() => ExtendAsync(session.SessionId, _customExtend ?? 0)">Extend</button>
                    </div>
                </div>
            }

            <details class="tile-more">
                <summary>Move to another station</summary>
            <div class="tile-flow">
                <div class="flow-label">Move</div>
                <div class="flow-controls">
                    <select class="form-select form-select-sm" aria-label="Move to station"
                            disabled="@(session.Status == SessionStatus.Grace || _busy)" @bind="_moveTarget">
                        <option value="0">Move to...</option>
                        @foreach (var target in IdleStations)
                        {
                            <option value="@target.Id">@target.Name</option>
                        }
                    </select>
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            disabled="@(session.Status == SessionStatus.Grace || _busy || _moveTarget == 0)"
                            @onclick="() => MoveAsync(session.SessionId)">Move</button>
                </div>
            </div>
            </details>
        }
    }
    else
    {
        <div class="tile-clock">
            <div class="countdown is-idle">Idle</div>
        </div>
        <div class="tile-flow">
            <div class="flow-label">Start prepaid</div>
            <div class="flow-controls quick-picks">
                @foreach (var m in StartPicks)
                {
                    <button type="button" class="btn btn-sm btn-outline-primary" disabled="@_busy"
                            @onclick="() => StartPrepaidAsync(m)">@m</button>
                }
            </div>
            <div class="flow-controls">
                <input type="number" class="form-control form-control-sm custom-minutes" min="1" max="1440"
                       placeholder="min" aria-label="Custom prepaid minutes" @bind="_customStart" />
                <button type="button" class="btn btn-sm btn-outline-primary" disabled="@(_busy || _customStart is null)"
                        @onclick="() => StartPrepaidAsync(_customStart ?? 0)">Start</button>
            </div>
        </div>

        <div class="tile-flow">
            <div class="flow-label">Customer (optional)</div>
            <CustomerPicker SelectedId="_pick?.Id" OnPicked="OnCustomerPickedAsync" />
            @if (_pick is not null && _usable > 0)
            {
                <div class="flow-sub start-from-balance">
                    <div class="flow-label">Start from balance</div>
                    <div class="flow-controls">
                        <input type="number" class="form-control form-control-sm custom-minutes" min="1" max="@_usable"
                               aria-label="Balance minutes" @bind="_balanceMinutes" />
                        <span class="flow-note">@_usable min available</span>
                        <button type="button" class="btn btn-sm btn-outline-primary"
                                disabled="@(_busy || _balanceMinutes is null)"
                                @onclick="StartFromBalanceAsync">Start from balance</button>
                    </div>
                </div>
            }
        </div>

        <div class="tile-actions">
            <button type="button" class="btn btn-sm btn-primary" disabled="@_busy"
                    @onclick="StartOpenEndedAsync">Start open-ended</button>
        </div>
    }

    @if (_settleOpen && _confirmQuote is { } settleCharge)
    {
        <PaymentDialog Title="@($"Stop & settle - {Model.Name}")" Items="SettleItems()" Due="_confirmTotalDue"
                       OnConfirm="ConfirmSettleAsync" OnClosed="SettleClosedAsync" />
    }

    @if (_error is not null)
    {
        <div class="banner banner-danger tile-banner" role="alert">@_error</div>
    }
    @if (_info is not null)
    {
        <div class="banner banner-warning alert-dismissible tile-banner" role="status">
            @_info
            <button type="button" class="btn-close" aria-label="Dismiss" @onclick="() => _info = null"></button>
        </div>
    }
</div>

@code {
    private static readonly int[] StartPicks = [30, 60, 120, 180];
    private static readonly int[] ExtendPicks = [15, 30, 60];

    private bool _busy;
    private string? _error;
    private string? _info;
    private decimal? _confirmQuote;
    private int? _confirmSessionId;
    private int _confirmVersion;
    private int? _customStart;
    private int? _customExtend;
    private int _moveTarget;
    private int _confirmRefund;
    private StopSettleQuote? _shownQuote;
    private IReadOnlyList<OutstandingItem> _confirmOrders = [];
    private decimal _confirmTotalDue;
    private bool _settleOpen;
    private bool _settleStoppedUnpaid;
    private bool _settleChanged;
    private string? _settleChangedMessage;
    private CustomerPick? _pick;
    private int _usable;
    private int? _balanceMinutes;
    private int? _payFallbackMinutes;
    private int? _payFallbackSessionId;
    private string? _payFallbackReason;

    [Parameter, EditorRequired] public StationCardModel Model { get; set; } = null!;

    [Parameter] public IReadOnlyList<IdleStation> IdleStations { get; set; } = [];

    [Parameter] public bool Acknowledged { get; set; }

    [Parameter] public EventCallback<string> OnNotice { get; set; }

    // The stop confirmation belongs to the session (and version) it was quoted for: drop it when the card shows
    // a different session or none, so a stale "Final charge" panel can never confirm a stop on another session.
    protected override void OnParametersSet()
    {
        // An open payment dialog outlives the session it stopped: it is closed by staff, not by a refresh.
        if (!_settleOpen && _confirmQuote is not null && Model.Session?.SessionId != _confirmSessionId)
        {
            ClearConfirm();
        }

        // The picked customer only belongs to an idle card: once a session runs, drop it.
        if (Model.Session is not null && (_pick is not null || _usable != 0))
        {
            ClearPick();
        }

        if (_payFallbackSessionId is not null && Model.Session?.SessionId != _payFallbackSessionId)
        {
            ClearPayFallback();
        }
    }

    private void ClearConfirm()
    {
        _confirmQuote = null;
        _confirmSessionId = null;
        _confirmRefund = 0;
        _shownQuote = null;
        _confirmOrders = [];
        _confirmTotalDue = 0m;
        _settleOpen = false;
        _settleStoppedUnpaid = false;
        _settleChanged = false;
        _settleChangedMessage = null;
    }

    private void ClearPick()
    {
        _pick = null;
        _usable = 0;
        _balanceMinutes = null;
    }

    private void ClearPayFallback()
    {
        _payFallbackMinutes = null;
        _payFallbackSessionId = null;
        _payFallbackReason = null;
    }

    private async Task OnCustomerPickedAsync(CustomerPick? pick)
    {
        _pick = pick;
        _usable = 0;
        _balanceMinutes = null;
        if (pick is null)
        {
            return;
        }

        try
        {
            _usable = await Balances.GetUsableMinutesForStationAsync(pick.Id, Model.StationId);
            _balanceMinutes = _usable > 0 ? Math.Min(60, _usable) : null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load the balance of customer {CustomerId}.", pick.Id);
            _error = "Something went wrong. Try again.";
        }
    }

    private string LevelClass => Model.Session is { } s
        ? SessionAlerts.GetLevel(s, Time.GetUtcNow()) switch
        {
            AlertLevel.TimeUp => "alert-timeup-level" + (Acknowledged ? " alert-acknowledged" : ""),
            AlertLevel.Warning => "alert-warning-level" + (Acknowledged ? " alert-acknowledged" : ""),
            _ => "",
        }
        : "";

    // Share of purchased time used, for timed sessions; null for open-ended ones.
    private static int? Progress(SessionCardModel session, DateTimeOffset now)
    {
        if (session.PurchasedMinutes is not { } minutes || minutes <= 0)
        {
            return null;
        }

        var active = SessionClock.ActiveSeconds(session.ClosedActiveSeconds, session.OpenSegmentStartUtc, now);
        return (int)Math.Clamp(Math.Round(active * 100.0 / (minutes * 60.0)), 0, 100);
    }

    private static string Countdown(SessionCardModel session, DateTimeOffset now)
    {
        var active = SessionClock.ActiveSeconds(session.ClosedActiveSeconds, session.OpenSegmentStartUtc, now);
        return session.PurchasedMinutes is { } minutes
            ? SessionClock.FormatCountdown(SessionClock.RemainingSeconds(minutes, active))
            : SessionClock.FormatCountdown(active);
    }

    public const string AgentOfflineNotice = "PC agent offline — the PC will unlock when it reconnects.";

    private async Task StartPrepaidAsync(int minutes)
    {
        if (await RunAsync(() => Sessions.StartPrepaidAsync(Model.StationId, minutes, _pick?.Id), "start the session"))
        {
            ClearPick();
            await NoticeIfAgentOfflineAsync();
        }
    }

    private async Task StartOpenEndedAsync()
    {
        if (await RunAsync(() => Sessions.StartOpenEndedAsync(Model.StationId, _pick?.Id), "start the session"))
        {
            ClearPick();
            await NoticeIfAgentOfflineAsync();
        }
    }

    private async Task StartFromBalanceAsync()
    {
        if (_pick is not { } pick || _balanceMinutes is not { } minutes)
        {
            return;
        }

        if (await RunAsync(() => Sessions.StartFromBalanceAsync(Model.StationId, pick.Id, minutes), "start the session from balance"))
        {
            ClearPick();
            await NoticeIfAgentOfflineAsync();
        }
    }

    private async Task ExtendFromBalanceAsync(int sessionId, int minutes)
    {
        ClearPayFallback();
        if (_busy)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var result = await Sessions.ExtendFromBalanceAsync(sessionId, minutes);
            if (result.Success)
            {
                _customExtend = null;
            }
            else if (result.Error is { } error && error.StartsWith(SessionService.InsufficientBalancePrefix, StringComparison.Ordinal))
            {
                // Never fall back silently: offer the paid extension and let staff choose.
                _payFallbackMinutes = minutes;
                _payFallbackSessionId = sessionId;
                _payFallbackReason = error;
            }
            else
            {
                _error = result.Error;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not extend session {SessionId} from balance.", sessionId);
            _error = "Something went wrong. Try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PayForExtensionAsync(int sessionId, int minutes)
    {
        if (await RunAsync(() => Sessions.ExtendAsync(sessionId, minutes), "extend the session"))
        {
            ClearPayFallback();
            _customExtend = null;
        }
    }

    // Starting on a disconnected PC is allowed; tell staff the PC will only unlock once its agent reconnects.
    private async Task NoticeIfAgentOfflineAsync()
    {
        if (Model.AgentOffline)
        {
            if (OnNotice.HasDelegate)
            {
                await OnNotice.InvokeAsync(AgentOfflineNotice);
            }
            else
            {
                _info = AgentOfflineNotice;
            }
        }
    }

    private Task PauseAsync(int sessionId) => RunAsync(() => Sessions.PauseAsync(sessionId), "pause the session");

    private Task ResumeAsync(int sessionId) => RunAsync(() => Sessions.ResumeAsync(sessionId), "resume the session");

    private async Task ExtendAsync(int sessionId, int minutes)
    {
        if (await RunAsync(() => Sessions.ExtendAsync(sessionId, minutes), "extend the session"))
        {
            _customExtend = null;
        }
    }

    private async Task MoveAsync(int sessionId)
    {
        if (await RunAsync(() => Sessions.MoveAsync(sessionId, _moveTarget), "move the session"))
        {
            _moveTarget = 0;
        }
    }

    private async Task BeginStopAsync(int sessionId)
    {
        _busy = true;
        _error = null;
        try
        {
            var quote = await Checkout.QuoteStopAndSettleAsync(sessionId);
            if (quote.Success)
            {
                ShowQuote(quote.Value!);
            }
            else
            {
                _error = quote.Error;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not quote the stop of session {SessionId}.", sessionId);
            _error = "Something went wrong. Try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    private void ShowQuote(StopSettleQuote quote)
    {
        var stop = quote.Stop;
        _shownQuote = quote;
        _confirmQuote = stop.Amount;
        _confirmRefund = stop.RefundMinutes;
        _confirmSessionId = stop.SessionId;
        _confirmVersion = stop.Version;
        _confirmOrders = quote.OpenOrders;
        _confirmTotalDue = quote.TotalDue;
    }

    private void BeginSettle()
    {
        if (_confirmQuote is null || _confirmSessionId is null || _confirmTotalDue <= 0m)
        {
            return;
        }

        _settleStoppedUnpaid = false;
        _settleChanged = false;
        _settleChangedMessage = null;
        _settleOpen = true;
    }

    private IReadOnlyList<OutstandingItem> SettleItems()
    {
        var items = new List<OutstandingItem>();
        if (_confirmQuote is > 0m and var charge && _confirmSessionId is { } sessionId)
        {
            items.Add(new OutstandingItem(AllocationTargetType.Session, sessionId, Model.Name, charge, 0m, charge));
        }

        items.AddRange(_confirmOrders);
        return items;
    }

    // The session is stopped only inside this call, so cancelling the dialog stops nothing.
    private async Task<PaymentDialogResult> ConfirmSettleAsync(IReadOnlyList<TenderLine> tenders)
    {
        if (_confirmSessionId is not { } sessionId || _confirmQuote is not { } charge)
        {
            return new PaymentDialogResult(false, "Close this window and try again.", null);
        }

        // Re-read what is owed first: if something changed since the quote, refuse before stopping anything.
        var current = await Checkout.QuoteStopAndSettleAsync(sessionId);
        if (current.Success && (current.Value!.TotalDue != _confirmTotalDue || current.Value.Stop.Version != _confirmVersion))
        {
            return await ChangedAsync(current.Value);
        }

        var result = await Checkout.StopAndSettleAsync(sessionId, _confirmVersion, charge, tenders, _confirmTotalDue);
        if (!result.Success)
        {
            if (result.Error == SessionService.ChangedMessage || result.Error == SettlementService.ChangedMessage)
            {
                // A minute boundary can pass between the re-read above and the stop: look again before giving up.
                var again = await Checkout.QuoteStopAndSettleAsync(sessionId);
                if (again.Success)
                {
                    return await ChangedAsync(again.Value!);
                }

                _settleChanged = true;
                _settleChangedMessage = result.Error;
            }

            return new PaymentDialogResult(false, result.Error, null);
        }

        if (result.Value!.PaymentError is { } paymentError)
        {
            Logger.LogWarning("Session {SessionId} stopped but its payment was refused: {Error}", sessionId, paymentError);
            _settleStoppedUnpaid = true;
            return new PaymentDialogResult(true, null, null);
        }

        return new PaymentDialogResult(true, null, result.Value.Settlement);
    }

    // An open-ended charge grows with the clock, so when only that changed, show the new total in the dialog and ask
    // staff to confirm it once more. Any other change (orders, version, prepaid/balance) closes the dialog and re-quotes.
    private async Task<PaymentDialogResult> ChangedAsync(StopSettleQuote current)
    {
        var openEnded = Model.Session?.Mode == SessionMode.OpenEnded;
        if (_shownQuote is { } shown && CheckoutService.OnlyElapsedChargeChanged(shown, current, openEnded))
        {
            var before = _confirmTotalDue;
            ShowQuote(current);
            await InvokeAsync(StateHasChanged);
            return new PaymentDialogResult(false,
                $"The session charge rose from {before.ToString("C")} to {_confirmTotalDue.ToString("C")} as time passed. Check the payment, then press Record payment to confirm the new amount.",
                null);
        }

        _settleChanged = true;
        _settleChangedMessage = SettlementService.ChangedMessage;
        return new PaymentDialogResult(false, SettlementService.ChangedMessage, null);
    }

    private async Task SettleClosedAsync(bool recorded)
    {
        var sessionId = _confirmSessionId;
        var stoppedUnpaid = _settleStoppedUnpaid;
        var changed = _settleChanged;
        var changedMessage = _settleChangedMessage;
        _settleOpen = false;
        _settleChanged = false;
        _settleChangedMessage = null;
        _settleStoppedUnpaid = false;

        if (recorded)
        {
            ClearConfirm();
            if (stoppedUnpaid)
            {
                _error = $"{Model.Name} stopped, but the payment failed. The items are under Open tabs.";
            }
            else
            {
                await OnNotice.InvokeAsync($"{Model.Name} stopped and settled.");
            }

            return;
        }

        if (changed && sessionId is { } id)
        {
            ClearConfirm();
            _error = changedMessage;
            await RequoteAsync(id);
        }
    }

    private async Task RequoteAsync(int sessionId)
    {
        try
        {
            var fresh = await Checkout.QuoteStopAndSettleAsync(sessionId);
            if (fresh.Success)
            {
                ShowQuote(fresh.Value!);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not re-quote the stop of session {SessionId}.", sessionId);
        }
    }

    private async Task ConfirmStopAsync(int sessionId)
    {
        if (_confirmSessionId != sessionId || _confirmQuote is not { } shown)
        {
            ClearConfirm();
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var shownRefund = _confirmRefund;
            var leftOwing = _confirmOrders.Count + (shown > 0m ? 1 : 0);
            var result = await Sessions.StopAsync(sessionId, _confirmVersion, shown);
            if (result.Success)
            {
                ClearConfirm();
                var refundText = shownRefund > 0 ? $" Refunded {shownRefund} min to balance." : string.Empty;
                var tabText = leftOwing > 0 ? $" Stopped. {leftOwing} item(s) left under Open tabs." : string.Empty;
                await OnNotice.InvokeAsync($"{Model.Name} stopped. Final charge: {result.Value.ToString("C")}{refundText}{tabText}");
            }
            else if (result.Error == SessionService.ChangedMessage)
            {
                // Show the new charge and require another confirmation.
                ClearConfirm();
                _error = result.Error;
                await RequoteAsync(sessionId);
            }
            else
            {
                _error = result.Error;
                ClearConfirm();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not stop session {SessionId}.", sessionId);
            _error = "Something went wrong. Try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    // Runs one service call with in-flight protection; the notifier refreshes the dashboard on success.
    private async Task<bool> RunAsync<T>(Func<Task<ServiceResult<T>>> action, string what)
    {
        if (_busy)
        {
            return false;
        }

        _busy = true;
        _error = null;
        try
        {
            var result = await action();
            if (!result.Success)
            {
                _error = result.Error;
            }

            return result.Success;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not {Action} for station {StationId}.", what, Model.StationId);
            _error = "Something went wrong. Try again.";
            return false;
        }
        finally
        {
            _busy = false;
        }
    }
}
