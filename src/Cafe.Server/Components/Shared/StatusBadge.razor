@using Cafe.Shared

<span class="capsule @Style"><span class="dot"></span>@Text</span>

@code {
    [Parameter, EditorRequired] public StationStatus Status { get; set; }

    private string Style => Status switch
    {
        StationStatus.Idle => "capsule-gray",
        StationStatus.InSession => "capsule-green",
        StationStatus.Paused => "capsule-orange",
        StationStatus.Expiring => "capsule-red alert-pulse",
        StationStatus.Offline => "capsule-gray",
        _ => "capsule-gray",
    };

    private string Text => Status switch
    {
        StationStatus.Idle => "Idle",
        StationStatus.InSession => "In session",
        StationStatus.Paused => "Paused",
        StationStatus.Expiring => "Expiring",
        StationStatus.Offline => "Offline",
        _ => Status.ToString(),
    };
}
