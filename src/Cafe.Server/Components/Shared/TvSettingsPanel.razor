@using Cafe.Server.Devices
@inject TvSettingsService TvSettings
@inject ILogger<TvSettingsPanel> Logger

<section class="mb-5 tv-settings-panel">
    <h2 class="title-2 mb-3">Samsung TVs</h2>

    <div class="group mb-3">
        <div class="group-row">
            <label class="row-label" for="tv-poweroff-toggle">Power off the TV when a session is stopped</label>
            <div class="form-check form-switch m-0 p-0">
                <input class="form-check-input tv-poweroff-toggle m-0 float-none" type="checkbox" role="switch" id="tv-poweroff-toggle" @bind="_powerOffOnStop" />
            </div>
        </div>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
        <button type="button" class="btn btn-tinted" disabled="@_saving" @onclick="SaveAsync">Save</button>
        @if (_message is not null)
        {
            <span class="small @(_ok ? "text-success" : "text-danger") tv-settings-message" role="status">@_message</span>
        }
    </div>

    <h3 class="group-caption">Enable these on each TV</h3>
    <div class="group mb-2">
        <div class="group-row">Power On with Mobile (Settings, General, Network, Expert Settings)</div>
        <div class="group-row">IP Remote (Settings, General, Network, Expert Settings)</div>
        <div class="group-row">Network standby, so the TV answers Wake-on-LAN while it is off</div>
    </div>
    <div class="group-footer">
        The TV must be on the same network with a fixed IP address. Enter that address and the TV's MAC address on the
        Stations page, then use Pair TV. A model without network standby may show Unreachable while it is off.
    </div>
</section>

@code {
    private bool _powerOffOnStop = true;
    private bool _saving;
    private bool _ok;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _powerOffOnStop = await TvSettings.GetPowerOffOnStopAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Could not load the TV settings.");
            _ok = false;
            _message = "Could not load the TV settings.";
        }
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        _saving = true;
        _message = null;
        try
        {
            await TvSettings.SetPowerOffOnStopAsync(_powerOffOnStop);
            _ok = true;
            _message = "Saved.";
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Could not save the TV settings.");
            _ok = false;
            _message = "Something went wrong. Try again.";
        }
        finally
        {
            _saving = false;
        }
    }
}
