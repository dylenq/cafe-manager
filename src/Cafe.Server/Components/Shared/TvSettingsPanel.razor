@using Cafe.Server.Devices
@inject TvSettingsService TvSettings
@inject ILogger<TvSettingsPanel> Logger

<div class="card mt-4 tv-settings-panel">
    <div class="card-body">
        <h2 class="h5 card-title">Samsung TVs</h2>

        <div class="form-check form-switch mb-2">
            <input class="form-check-input tv-poweroff-toggle" type="checkbox" role="switch" id="tv-poweroff-toggle" @bind="_powerOffOnStop" />
            <label class="form-check-label" for="tv-poweroff-toggle">Power off the TV when a session is stopped</label>
        </div>
        <button type="button" class="btn btn-primary btn-sm" disabled="@_saving" @onclick="SaveAsync">Save</button>
        @if (_message is not null)
        {
            <span class="ms-2 small @(_ok ? "text-success" : "text-danger") tv-settings-message" role="status">@_message</span>
        }

        <h3 class="h6 mt-4">Enable these on each TV</h3>
        <ul class="small mb-2">
            <li>Power On with Mobile (Settings, General, Network, Expert Settings)</li>
            <li>IP Remote (Settings, General, Network, Expert Settings)</li>
            <li>Network standby, so the TV answers Wake-on-LAN while it is off</li>
        </ul>
        <p class="small text-muted mb-0">
            The TV must be on the same network with a fixed IP address. Enter that address and the TV's MAC address on the
            Stations page, then use Pair TV. A model without network standby may show Unreachable while it is off.
        </p>
    </div>
</div>

@code {
    private bool _powerOffOnStop = true;
    private bool _saving;
    private bool _ok;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _powerOffOnStop = await TvSettings.GetPowerOffOnStopAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Could not load the TV settings.");
            _ok = false;
            _message = "Could not load the TV settings.";
        }
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        _saving = true;
        _message = null;
        try
        {
            await TvSettings.SetPowerOffOnStopAsync(_powerOffOnStop);
            _ok = true;
            _message = "Saved.";
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "Could not save the TV settings.");
            _ok = false;
            _message = "Something went wrong. Try again.";
        }
        finally
        {
            _saving = false;
        }
    }
}
